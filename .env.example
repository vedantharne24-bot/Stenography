# Copy to .env (repository root) for docker compose, or to backend/.env for local development
# (scripts/init_env.py generates backend/.env with strong random values). Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev default (when unset): SQLite at backend/storage/stegolab.db
DATABASE_URL=postgresql+psycopg://stegolab:CHANGE_ME@localhost:5432/stegolab
POSTGRES_PASSWORD=CHANGE_ME            # docker compose only

# --- Secrets (>= 32 random characters each; required in production) ---------
SECRET_KEY=
JWT_SECRET=

# --- Runtime ------------------------------------------------------------------
APP_ENV=development                    # development | test | production
COOKIE_SECURE=false                    # true behind HTTPS
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Paths --------------------------------------------------------------------
MODEL_PATH=./models                    # trained model registry (backend/models)
UPLOAD_DIR=./storage                   # generated artefacts (temporary + user-owned)
DATASET_DIR=../data/dataset            # held-out test carriers for experiments / demo

# --- Limits & retention -----------------------------------------------------
MAX_UPLOAD_SIZE=20971520               # bytes
MAX_PAYLOAD_FILE_SIZE=2097152          # bytes
MAX_IMAGE_PIXELS=36000000              # decompression-bomb guard
TEMP_RETENTION_HOURS=24

# --- Payload key derivation (Argon2id) ------------------------------------
KDF_TIME_COST=3
KDF_MEMORY_KIB=65536
KDF_PARALLELISM=4

# --- Rate limits (per IP per window) ------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_HEAVY=30

# --- ML -----------------------------------------------------------------------
DEVICE=auto                            # auto | cuda | cpu
MAX_INFERENCE_TILES=64

# --- First administrator (python -m app.cli bootstrap-admin) ---------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
